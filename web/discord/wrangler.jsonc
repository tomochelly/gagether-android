{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gagether-discord",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "GAGETHER_ORIGIN": "https://gagether.wiki",
    "DISCORD_APPLICATION_ID": "1563212837889769523",
    "BOT_ENABLED": "false",
    "SCHEDULER_ENABLED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gagether-discord",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
