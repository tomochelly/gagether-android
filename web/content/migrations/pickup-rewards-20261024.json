          "name": {
            "ko": "사의 증표",
            "en": "Si Token",
            "ja": "スーの印",
            "zh": "祀的信物"
          },
          "quantity": "1",
          "sourceUrl": "https://endfield.gryphline.com/ko-kr/news/4489",
