<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="GAGETHER" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="#D5EDB7"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="26dp" android:paddingLeft="12dp" android:paddingRight="2dp" android:gravity="center" android:text="↻" android:textSize="20sp" android:textColor="#ADC997" android:contentDescription="Refresh"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_lead" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_image" android:layout_width="48dp" android:layout_height="58dp" android:layout_marginEnd="13dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription=""/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/widget_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GAME / SCHEDULE" android:textSize="10sp" android:textColor="#A5BD94" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="GAGETHER" android:textSize="14sp" android:textStyle="bold" android:textColor="#EDF5E2" android:maxLines="1" android:ellipsize="end"/>
   <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="20sp" android:textColor="#D1EAA7" android:fontFamily="@font/oxanium"/>
   <TextView android:id="@+id/widget_deadline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="9sp" android:textColor="#90A780" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="13sp" android:textColor="#BFCEAF" android:visibility="gone"/>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#BFCEAF" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="8sp" android:textColor="#8FA57E" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
