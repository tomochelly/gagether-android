<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="GAGETHER" android:letterSpacing="0.07" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:textColor="@color/widget_ink"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="32dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:includeFontPadding="false" android:textColor="@color/widget_accent"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:includeFontPadding="false" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textSize="9sp" android:includeFontPadding="false" android:textColor="@color/widget_muted"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/widget_rule" android:dividerHeight="1dp"/>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:includeFontPadding="false" android:textColor="@color/widget_muted"/>
 </FrameLayout>
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:textSize="9sp" android:includeFontPadding="false" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
