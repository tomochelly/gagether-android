  <receiver android:name=".DeadlineWidget" android:exported="false" android:label="GAGETHER · 마감 일정"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/deadline_widget"/></receiver>
 </application>
</manifest>
