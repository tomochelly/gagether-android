    {
      "id": "recap-bluearchive-ko-LHjOwvjrrVE",
      "set": {
        "title": {
          "ko": "[블루 아카이브] 5주년 페스티벌 & 사운드 아카이브  - 현장 중계 1일차",
          "en": "Blue Archive 5th Anniversary Festival & Sound Archive — Day 1 Live Coverage",
          "ja": "ブルーアーカイブ 5周年フェスティバル＆サウンドアーカイブ — 現地中継1日目",
          "zh": "蔚蓝档案5周年庆典＆Sound Archive——现场转播第1天"
        },
        "summary": {
